generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id
  email             String             @unique
  name              String?
  image             String?
  providerImage     String?
  customAvatarUrl   String?
  stripeCustomerId  String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subscriptions     Subscription[]
  creditBatches     CreditBatch[]
  generations       Generation[]
  mediaAssets       MediaAsset[]
  mediaUploadGrants MediaUploadGrant[]
  checkoutReservations CheckoutReservation[]
  upgradeConsumptions UpgradeConsumption[]
}

model CheckoutReservation {
  id                    String   @id
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountCreatedAt      DateTime
  kind                  String
  priceKey              String
  stripePriceId         String
  predecessorId         String?
  stripeSessionId       String?  @unique
  stripeSubscriptionId  String?  @unique
  // Immutable Stripe request bodies; committed before any external creation.
  sessionParams         Json
  couponParams          Json?
  status                String   @default("creating")
  expiresAt             DateTime
  closedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // SQL migration adds unique(userId) WHERE closedAt IS NULL.
  @@index([userId, createdAt])
}

model UpgradeConsumption {
  predecessorId         String   @id
  successorId           String   @unique
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountCreatedAt      DateTime
  createdAt             DateTime @default(now())

  @@index([userId])
}

model MediaUploadGrant {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  maxBytes    Int
  blobUrl     String?   @unique
  actualBytes Int?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, completedAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  stripePriceId        String
  planType             String
  billingCycle         String
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Next scheduled monthly credit grant (yearly plans: months 2–12)
  nextCreditAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model CreditBatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  remaining Int
  expiresAt DateTime
  source    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Generation {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  status            String
  urls              String[]          @default([])
  inputUrls         String[]          @default([])
  prompt            String
  taskId            String?           @unique
  error             String?
  modelOptionId     String?
  parameters        Json?
  creditsCost       Int?
  creditConsumption Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  media             GenerationMedia[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model MediaAsset {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  url         String
  contentType String?
  sizeBytes   Int?
  origin      String
  createdAt   DateTime          @default(now())
  generations GenerationMedia[]

  @@unique([userId, url])
  @@index([userId, type, createdAt(sort: Desc)])
}

model GenerationMedia {
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  role         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@id([generationId, mediaAssetId, role])
  @@index([generationId, role, position])
  @@index([mediaAssetId])
}
